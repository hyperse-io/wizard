{
  "name": "@hyperse/wizard",
  "version": "1.0.6",
  "homepage": "https://github.com/hyperse-io/wizard",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperse-io/wizard",
    "directory": "packages/wizard"
  },
  "license": "SEE LICENSE IN FILE 'LICENSE'",
  "author": {
    "name": "Hyperse",
    "url": "https://github.com/hyperse-io"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin/",
    "dist/",
    "index.js",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "serve": "yarn node --import=@hyperse/ts-node/register ./tests/load-config/test-serve.ts",
    "build": "rimraf dist && tsc -p ./tsconfig.build.json",
    "minify": "node ../../scripts/minify.mjs --dest=dist",
    "clean": "rimraf --no-glob ./dist ./coverage ./tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "test": "run-s test-unit",
    "test-unit": "vitest run",
    "test-task": "vitest run",
    "test-coverage": "vitest run --coverage",
    "test-unit-watch": "vitest watch --ui",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hyperse/config-loader": "^1.0.9",
    "@hyperse/deep-merge": "^1.0.1",
    "@hyperse/hyper-env": "^1.0.18",
    "@hyperse/logger": "^1.1.7",
    "@hyperse/logger-plugin-stdout": "^1.0.11",
    "@hyperse/pipeline": "^1.0.6",
    "@hyperse/translator": "^1.3.3",
    "import-meta-resolve": "^4.2.0",
    "is-platform": "^1.0.0",
    "type-fest": "^5.10.0",
    "type-flag": "^4.5.2",
    "yocto-spinner": "^1.2.2"
  },
  "devDependencies": {
    "@hyperse/eslint-config-hyperse": "^1.7.4",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "eslint": "^10.12.0",
    "jsdom": "30.1.2",
    "npm-run-all": "4.1.5",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
