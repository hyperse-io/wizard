{
  "name": "@hyperse/wizard-plugin-completion",
  "version": "1.0.4",
  "homepage": "https://github.com/hyperse-io/wizard",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperse-io/wizard",
    "directory": "packages/wizard-plugin-completion"
  },
  "author": {
    "name": "Hyperse",
    "url": "https://github.com/hyperse-io"
  },
  "type": "module",
  "license": "SEE LICENSE IN FILE 'LICENSE'",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin/",
    "dist/",
    "index.js",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "cli": "yarn node --import=@hyperse/ts-node/register ./tests/cli.ts",
    "build": "rimraf dist && tsc -p ./tsconfig.build.json",
    "minify": "node ../../scripts/minify.mjs --dest=dist",
    "clean": "rimraf --no-glob ./dist ./coverage ./tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "test": "run-s test-unit",
    "test-unit": "vitest run",
    "test-coverage": "vitest run --coverage",
    "test-unit-watch": "vitest watch --ui",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hyperse/wizard": "workspace:*"
  },
  "devDependencies": {
    "@hyperse/eslint-config-hyperse": "^1.7.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "@withfig/autocomplete-types": "^1.31.0",
    "eslint": "^10.12.0",
    "jsdom": "30.1.2",
    "npm-run-all": "4.1.5",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
